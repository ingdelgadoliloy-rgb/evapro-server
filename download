const test = require("node:test");
const assert = require("node:assert/strict");
const fs = require("node:fs");
const { spawnSync } = require("node:child_process");
const path = require("node:path");

process.env.NODE_ENV = "test";
process.env.ADMIN_SECRET = "test-only-secret-with-sufficient-length";
process.env.EVAPRO_DATA_FILE = `${__dirname}/tmp-${process.pid}.json`;
fs.rmSync(process.env.EVAPRO_DATA_FILE, { force: true });

const { server } = require("../server");

let baseUrl;
let adminCookie = "";
let adminCsrf = "";
test.before(async () => {
  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
  baseUrl = `http://127.0.0.1:${server.address().port}`;
  const response = await fetch(baseUrl + "/api/auth/admin", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ secret: process.env.ADMIN_SECRET, tenantId: "school" }) });
  const payload = await response.json();
  adminCookie = response.headers.get("set-cookie");
  adminCsrf = payload.csrfToken;
});
test.after(async () => new Promise((resolve) => server.close(resolve)));

async function json(path, options = {}) {
  if (options.admin === true) {
    options.headers = { ...options.headers, cookie: adminCookie, "x-csrf-token": adminCsrf };
    delete options.admin;
  }
  const response = await fetch(baseUrl + path, options);
  return { response, body: await response.json() };
}

async function capability(sessionId, tenantId, doc) {
  const result = await json("/api/attempt/capability", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ sessionId, tenantId, doc }) });
  assert.equal(result.response.status, 201);
  assert.match(result.body.capability, /^[A-Za-z0-9_-]{43}$/);
  assert.equal(result.body.capability.includes("."), false);
  return result.body.capability;
}

