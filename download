test("student package excludes roster and answer keys; score is server-derived", async () => {
  const exam = {
    schema: "evaluapro-utch.studentlink.v3",
    tenantId: "school",
    allowedAccess: [{ name: "Private Student", doc: "12345678" }],
    settings: { questionTotal: 1 },
    questionBank: [{
      type: "multiple_choice",
      question: "Two plus two?",
      options: ["3", "4", "5"],
      correct: 1,
      rationale: "Arithmetic"
    }]
  };
  let result = await json("/api/exam/session-a", {
    method: "POST",
    admin: true, headers: { "content-type": "application/json" },
    body: JSON.stringify({ tenantId: "school", package: exam })
  });
  assert.equal(result.response.status, 200);

  const token = await capability("session-a", "school", "12345678");
  result = await json("/api/attempt/exam", { headers: { authorization: `Bearer ${token}` } });
  assert.deepEqual(result.body.package.allowedAccess, []);
  assert.equal(result.body.package.questionBank[0].correct, undefined);
  assert.equal(result.body.package.questionBank[0].rationale, undefined);

  result = await json("/api/attempt/submit", {
    method: "POST",
    headers: { "content-type": "application/json", authorization: `Bearer ${token}` },
    body: JSON.stringify({ entry: {
      name: "Private Student", doc: "12345678", score: 999, percent: 100, grade: 5,
      answers: [{ type: "multiple_choice", question: "Two plus two?", selected: 0, isCorrect: true, correctAnswer: "4" }]
    } })
  });
  assert.equal(result.response.status, 200);
  assert.equal(result.body.receipt.score, 0);
  assert.equal(result.body.receipt.verifiedByServer, true);
  assert.ok(result.body.receipt.receiptId);
  assert.equal(result.body.receipt.answers, undefined);
  assert.equal(JSON.stringify(result.body).includes("correctAnswer"), false);
});

