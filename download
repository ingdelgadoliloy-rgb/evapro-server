test("capability is mandatory, opaque, tenant-bound and API is no-store", async () => {
  let result = await json("/api/attempt/exam");
  assert.equal(result.response.status, 401);
  assert.match(result.response.headers.get("cache-control"), /no-store/);
  result = await json("/api/attempt/status", { method: "POST", headers: { "content-type": "application/json", authorization: "Bearer forged.token" }, body: "{}" });
  assert.equal(result.response.status, 401);
  assert.equal(JSON.stringify(result.body).includes("12345678"), false);
});

test("opaque capability is stored only by hash and survives JSON persistence", async () => {
  const exam = { schema: "evaluapro-utch.studentlink.v3", tenantId: "opaque", allowedAccess: [{ name: "Opaque Student", doc: "77777111" }], settings: { questionTotal: 1 }, questionBank: [{ type: "multiple_choice", question: "One plus one?", options: ["2", "3", "4"], correct: 0, rationale: "Arithmetic" }] };
  const publication = await json("/api/exam/opaque-1", { method: "POST", admin: true, headers: { "content-type": "application/json" }, body: JSON.stringify({ tenantId: "opaque", package: exam }) });
  assert.equal(publication.response.status, 200, JSON.stringify(publication.body));
  const token = await capability("opaque-1", "opaque", "77777111");
  const persisted = fs.readFileSync(process.env.EVAPRO_DATA_FILE, "utf8");
  assert.equal(persisted.includes(token), false);
  assert.equal(persisted.includes('"sub":"12345678"'), false);
  assert.match(persisted, /"capabilities"/);
});

test("admin login uses HttpOnly cookie and CSRF protects cookie sessions", async () => {
  const login = await json("/api/auth/admin", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ secret: process.env.ADMIN_SECRET, tenantId: "school" }) });
  assert.equal(login.response.status, 200);
  const cookie = login.response.headers.get("set-cookie");
  assert.match(cookie, /HttpOnly/i);
  assert.equal(JSON.stringify(login.body).includes(process.env.ADMIN_SECRET), false);
  const rejected = await json("/api/ws-ticket", { method: "POST", headers: { "content-type": "application/json", cookie }, body: JSON.stringify({ tenantId: "school", sessionId: "session-a" }) });
  assert.equal(rejected.response.status, 403);
  const accepted = await json("/api/ws-ticket", { method: "POST", headers: { "content-type": "application/json", cookie, "x-csrf-token": login.body.csrfToken }, body: JSON.stringify({ tenantId: "school", sessionId: "session-a" }) });
  assert.equal(accepted.response.status, 200);
});

test("normal submit is idempotent and mutually exclusive with anomaly closure", async () => {
  const exam = { schema: "evaluapro-utch.studentlink.v3", tenantId: "race", allowedAccess: [{ name: "Race Student", doc: "55555111" }], settings: { questionTotal: 1 }, questionBank: [{ type: "multiple_choice", question: "Two plus two?", options: ["3", "4", "5"], correct: 1, rationale: "Arithmetic" }] };
  const published = await json("/api/exam/race-1", { method: "POST", admin: true, headers: { "content-type": "application/json" }, body: JSON.stringify({ tenantId: "race", package: exam }) });
  assert.equal(published.response.status, 200, JSON.stringify(published.body));
  const token = await capability("race-1", "race", "55555111");
  const entry = { name: "Race Student", answers: [{ type: "multiple_choice", question: "Two plus two?", selected: 1 }] };
  const [submit, closure] = await Promise.all([
    json("/api/attempt/submit", { method: "POST", headers: { "content-type": "application/json", authorization: `Bearer ${token}` }, body: JSON.stringify({ entry }) }),
    json("/api/attempt/closure", { method: "POST", headers: { "content-type": "application/json", authorization: `Bearer ${token}` }, body: JSON.stringify({ entry: { name: "Race", closureKey: "internal", closureCode: "CI-01", closureReason: "fallo" } }) })
  ]);
  assert.equal(submit.response.status, 200);
  assert.equal(closure.response.status, 200);
  assert.equal([submit.body.duplicate, closure.body.duplicate].filter(Boolean).length, 1);
  const again = await json("/api/attempt/submit", { method: "POST", headers: { "content-type": "application/json", authorization: `Bearer ${token}` }, body: JSON.stringify({ entry }) });
  assert.equal(again.response.status, 200);
  assert.equal(again.body.duplicate, true);
  assert.ok(again.body.receipt.receiptId);
  const recovery = await json("/api/attempt/status", { method: "POST", headers: { authorization: `Bearer ${token}` } });
  assert.equal(recovery.response.status, 200);
  assert.equal(recovery.body.receipt.verifiedByServer, true);
  assert.ok(recovery.body.receipt.receiptId);
});
