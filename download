test("production fails closed when mandatory environment is absent", () => {
  const env = { ...process.env, NODE_ENV: "production", DATABASE_URL: "", TOKEN_HASH_SECRET: "", ADMIN_SECRET: "", ALLOWED_ORIGINS: "" };
  const child = spawnSync(process.execPath, ["-e", "require('./server')"], { cwd: path.join(__dirname, ".."), env, encoding: "utf8" });
  assert.notEqual(child.status, 0);
  assert.match(child.stderr, /Configuracion de produccion incompleta/);
});

